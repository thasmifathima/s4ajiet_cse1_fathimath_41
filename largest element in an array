public class LargestElement {
    public static void main(String[] args) {
        int i;
        int [] arr={10,20,30,40,50};
        int largest=arr[0];
        for(i=1;i<arr.length;i++)
        {
            if(arr[i]>largest){
                largest =arr[i];
            }
        }
        
        System.out.println("Largest element is:"+largest);
    }
}
output
Largest element is:50
