public class Smallestlement {
    public static void main(String[] args) {
        int i;
        int [] arr={10,20,30,40,50};
        int smallest=arr[0];
        for(i=1;i<arr.length;i++)
        {
            if(arr[i]<smallest){
                smallest =arr[i];
            }
        }
        
        System.out.println("Smallest element is:"+smallest);
    }
}
