swap any two numbers
class Main {
    public static void main(String[] args) {
        int a=2;
        int b=3;
        System.out.println("Before swap :a="+a+"and b="+b);
        int temp=a;
        a=b;
        b=temp;
        System.out.println("after swap:a="+a+"and b="+b);
        
    }
}

class Main {
    public static void main(String[] args) {
        int a=2;
        int b=3;
        System.out.println("Before swap :a="+a+"and b="+b);
        a=a+b;
        b=a-b;
        a=a-b;
        System.out.println("after swap:a="+a+"and b="+b);
        
    }
}
swap any two numbers using gates
class Main {
    public static void main(String[] args) {
        int a=2;
        int b=3;
        System.out.println("Before swap :a="+a+"and b="+b);
        a=a^b;
        b=a^b;
        a=a^b;
        System.out.println("after swap:a="+a+"and b="+b);
        
    }
}
output:
Before swap :a=2and b=3
after swap:a=3and b=2
